# smoke_4gpu -- a minutes-long end-to-end check of any arm on 4 GPUs (NOT a reproduction: no number from a
# smoke run is comparable to the paper). Apply with `--overlay smoke_4gpu` (resolver) or the launcher flag.
# Keys that a benchmark does not use are ignored by its launcher.
#
# Shape: 8 train tasks, batch 4 tasks x 2 samples (2 steps per epoch), eval on 8 tasks with 1 sample,
# 6 turns, 16k context, 8 environment servers, one checkpoint (written at the last step). The arm's real
# hint files are used. 4B students only: the 30B (Megatron, TP4 x EP8) arms do not fit on 4 GPUs.
#
# Only keys that mean the same thing in every benchmark belong here. Benchmark-specific smoke values go in
# opsd/recipes/<bench>/overlays/smoke_4gpu.env, which the resolver applies right after this file. In
# particular MAX_STEPS is NOT set here: tau2 reads it as the per-episode turn cap (its training-step count
# is ROLLOUT_BATCHES), and tau2 does not derive its inference-engine count from NUM_GPUS_PER_NODE, so its
# own refinement sets the turn cap and NUM_INFERENCE_ENGINES / INFERENCE_ENGINE_TP_SIZE for 4 GPUs.

NUM_NODES=1
NUM_GPUS_PER_NODE=4

# The launcher keeps the first N task ids of the train / eval lists (deterministic order).
OPSD_SMOKE=1
OPSD_MAX_TRAIN_TASKS=8
OPSD_MAX_EVAL_TASKS=8

TRAIN_BATCH_SIZE=4
N_SAMPLES=2
EVAL_N_SAMPLES=1
FINAL_TEST_N_SAMPLES=1
EVAL_BATCH_SIZE=8
EVAL_BEFORE_TRAIN=true
EVAL_INTERVAL=2

# 2 training steps: ALFWorld / AppWorld = 1 epoch of 8 tasks at batch 4; tau2 = ROLLOUT_BATCHES
TRAINER_EPOCHS=1
EPOCHS=1
ROLLOUT_BATCHES=2
# one checkpoint, at step 2 (exercises the save path; the end-of-training save rewrites that same step dir).
# A 4B FSDP checkpoint (fp32 weights + two Adam moments) is roughly 48 GB, hence the disk floor below.
CKPT_INTERVAL=2
MAX_CKPTS_TO_KEEP=1
OPSD_PREFLIGHT_MIN_FREE_GB=64

MAX_TURNS=6
ALFWORLD_MAX_STEPS=6
MAX_MODEL_LEN=16384
MAX_INPUT_LENGTH=12288
MAX_GENERATE_LENGTH=4096

# 8 environment servers; one env worker per concurrent trajectory (4 x 2 train, 8 x 1 eval) and spare
NUM_ALFWORLD_SERVERS=8
NUM_APPWORLD_SERVERS=8
MAX_ENV_WORKERS=16

# Non-default port bases, so a smoke never collides with a full run on the same host (preflight checks
# that every port in each range is free before anything starts). All of them stay OUTSIDE Ray's default
# worker-port range (10002-19999), where a Ray worker could take the port after preflight, and clear of the
# full-run defaults: ALFWorld 9100.. (+128 servers), AppWorld 21000-21239, HTTP endpoint 8000 (tau2: 8110),
# a self-hosted tau2 simulator 8000.., the AppWorld pass@k / PI-utility vLLM servers 8500.. and their
# AppWorld servers 22000..
ALFWORLD_BASE_PORT=9500
APPWORLD_BASE_PORT=21300
HTTP_ENDPOINT_PORT=8600

LOGGER=console
