# Vanilla OPSD (main / null tables): pure on-policy self-distillation. The student rolls out WITHOUT the
# hint; the frozen initial model conditioned on the hint (a <Secret information> block prepended to the
# prompt) is the teacher; the per-token reward is -k1(student || teacher). Env reward weight 0, no_op
# advantage, importance-sampling loss: the per-token reward IS the advantage.
TRAIN_ENTRYPOINT=opsd.trainer.main_opsd_appworld
ADVANTAGE_ESTIMATOR=no_op
POLICY_LOSS_TYPE=importance_sampling
GRPO_NORM_BY_STD=false
EPS_CLIP_HIGH=0.2
# use_kl_in_reward=true builds the ref worker (= the frozen teacher) and gates the OPSD reward; it is
# mutually exclusive with use_kl_loss. KL_LOSS_COEF is inert here.
USE_KL_IN_REWARD=true
USE_KL_LOSS=false
KL_LOSS_COEF=0.001
LR=1.0e-6
OVERLONG_BUFFER_LEN=0
# ---- OPSD knobs (read by the trainer / generator from the environment) ----
OPSD_TEACHER=frozen
OPSD_DISTILL_COEF=1.0
OPSD_ENV_COEF=0
OPSD_TOKEN_CLIP=0
OPSD_LENGTH_NORM=0
OPSD_DISTILL_SIDE=both
OPSD_DISTILL_SIDE_MATCH=0
# Teacher-forward length cap (hint + prompt + response); above the policy budget so long hints are kept.
OPSD_REF_SEQ_CAP=98304
OPSD_SKIP_NO_HINT=1
# ---- logging only ----
OPSD_WANDB_TRAJ_N=4
OPSD_KL_LOG_INTERVAL=5
OPSD_DUMP_FULL_N=100000
OPSD_DUMP_HTML_PROMPT_CHARS=0
OPSD_DUMP_HTML_RESP_CHARS=0
OPSD_DUMP_HTML_HINT_CHARS=0
# ---- evaluation: step-0 eval, then the chained test (test_normal + test_challenge) after training ----
EVAL_BEFORE_TRAIN=true
FINAL_TEST=true
EVAL_OOD=true
