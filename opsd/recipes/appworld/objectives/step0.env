# Step-0 baseline (step0 table): evaluate the untrained student on test_normal-168 with its own sampling,
# 4 samples per task -- the eval_before_train evaluation every OPSD run starts with (the published
# number averages that evaluation over the runs of each student). No training, no PI.
TRAIN_ENTRYPOINT=opsd.appworld.main_appworld
EVAL_ONLY=1
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
GRPO_NORM_BY_STD=true
EPS_CLIP_HIGH=0.2
USE_KL_LOSS=false
USE_KL_IN_REWARD=false
KL_LOSS_COEF=0.0
LR=1.0e-6
OVERLONG_BUFFER_LEN=0
