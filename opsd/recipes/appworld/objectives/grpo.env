# DAPO baseline (grpo table): GRPO advantage with std normalisation, token-mean loss, clip-higher
# (0.2 / 0.28), DAPO soft overlong punishment, no KL term and no reference model. No PI anywhere.
TRAIN_ENTRYPOINT=opsd.appworld.main_appworld
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
GRPO_NORM_BY_STD=true
EPS_CLIP_HIGH=0.28
USE_KL_LOSS=false
USE_KL_IN_REWARD=false
KL_LOSS_COEF=0.0
LR=3.0e-6
# Soft overlong punishment onset = (MAX_INPUT_LENGTH + MAX_GENERATE_LENGTH) - 13152 = 36000 tokens of the
# whole trajectory; the penalty grows linearly to 0.5 (half a success) over the buffer.
OVERLONG_BUFFER_LEN=13152
# ---- logging only: full rollout dumps + a W&B rollout table ----
APPWORLD_DUMP_ROLLOUTS=1
APPWORLD_WANDB_TRAJ_N=4
