# DAPO + OPSD, advantage mix (opsd_grpo table): A = lambda * A_GRPO + (1 - lambda) * (-k1(student||teacher)),
# per token, with the frozen initial model + hint as the teacher, inside the DAPO recipe. lambda comes
# from the arm id (OPSD_MIX_LAMBDA).
TRAIN_ENTRYPOINT=opsd.trainer.main_opsd_appworld
# ---- the DAPO recipe of the grpo table, unchanged ----
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
GRPO_NORM_BY_STD=true
EPS_CLIP_HIGH=0.28
LR=3.0e-6
OVERLONG_BUFFER_LEN=13152
# ---- the teacher: a ref worker at zero KL weight. use_kl_loss=true with coefficient 0 is how the ref
# model (the teacher) is instantiated without a KL leash; use_kl_in_reward stays false so the teacher
# term never enters the env reward that drives the GRPO advantage.
USE_KL_LOSS=true
KL_LOSS_COEF=0.0
USE_KL_IN_REWARD=false
# ---- OPSD knobs inherited from the OPSD run-file (the reward-path ones are inert on this path) ----
OPSD_DISTILL_COEF=1.0
OPSD_ENV_COEF=0
OPSD_TOKEN_CLIP=0
OPSD_LENGTH_NORM=0
OPSD_DISTILL_SIDE=both
OPSD_DISTILL_SIDE_MATCH=0
OPSD_REF_SEQ_CAP=98304
OPSD_SKIP_NO_HINT=1
# ---- logging only ----
OPSD_WANDB_TRAJ_N=4
OPSD_KL_LOG_INTERVAL=5
OPSD_DUMP_FULL_N=100000
OPSD_DUMP_HTML_PROMPT_CHARS=0
OPSD_DUMP_HTML_RESP_CHARS=0
OPSD_DUMP_HTML_HINT_CHARS=0
OPSD_MIX_LAMBDA=0.99
OPSD_TEACHER=frozen
# Inert with a frozen teacher (recorded as run).
OPSD_TEACHER_ALPHA=0.01
OPSD_EMA_INTERVAL=5
