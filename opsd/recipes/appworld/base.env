# AppWorld bench defaults: every value here is shared by all AppWorld paper arms (or is the run-file
# default that an arm inherited), so each key matches what the runs actually used. Students, objectives
# and the arm tables (arms.yaml) override from here. Consumed by scripts/appworld/run.sh.
#
# Task data: AppWorld train-90 (30 scenarios x 3 variants, the three b0a8eae_* tasks patched by the
# encrypted data bundle -- see scripts/setup/setup_appworld.sh), validated on test_normal-168.
# 90 tasks / batch 18 = 5 steps per epoch, 30 epochs = 150 steps.

# ---- data, prompt, scaffold ----------------------------------------------------------------------------
PROMPT_VARIANT=official
SCAFFOLD=official
STRICT_PARSE=true
REWARD_MODE=binary
REMINDER_EVERY=0
MAX_TURNS=30
MAX_INTERACTIONS=50
EXECUTE_TIMEOUT=120
# 0 = validate on dev-57, 1 = validate on test_normal-168, both = dev-57 + test_normal-168 every eval.
VAL_ON_TEST=1
# 1 = train on train-90 + dev-57 (147 tasks; requires VAL_ON_TEST=1). No paper arm does.
TRAIN_INCLUDE_DEV=0

# ---- rollout / batch shape -----------------------------------------------------------------------------
N_SAMPLES=8
TRAIN_BATCH_SIZE=18
TRAINER_EPOCHS=30
EVAL_INTERVAL=25
EVAL_N_SAMPLES=4
EVAL_BATCH_SIZE=60
EVAL_BEFORE_TRAIN=false
# Chained test after training (test_normal, plus test_challenge-139 when EVAL_OOD=true) on the best
# checkpoint of the validation curve. Not used by any paper number.
FINAL_TEST=false
EVAL_OOD=false
FINAL_TEST_N_SAMPLES=4
FINAL_TEST_CKPT_STEP=
# 1 = evaluate only (no training): the base model, or RESUME_PATH=<run_dir>/ckpts/global_step_N.
EVAL_ONLY=0

# ---- sampling: untruncated on-policy training rollouts; eval sampling is per student --------------------
TEMPERATURE=1.0
TOP_P=1.0
TOP_K=-1
MIN_P=0.0

# ---- lengths (MAX_INPUT_LENGTH defaults to MAX_MODEL_LEN - MAX_GENERATE_LENGTH in the launcher) ----------
MAX_MODEL_LEN=49152
MAX_GENERATE_LENGTH=8192
MAX_PROMPT_LENGTH=4096

# ---- overlong handling (the DAPO soft overlong buffer length is set per objective) -----------------------
# Truncated rollouts are masked out of the loss; their reward is kept.
APPLY_OVERLONG_FILTERING=true
ZERO_REWARD_ON_NON_STOP=false
# Penalty on DAPO's own +/-1 reward span, rescaled to AppWorld's binary 0/1 span: saturates at 0.5.
OVERLONG_PENALTY_FACTOR=1.0
OVERLONG_REWARD_RANGE=1.0

# ---- algorithm settings shared by every objective (the objective files set the rest) --------------------
LOSS_REDUCTION=token_mean
EPS_CLIP_LOW=0.2
# trainer.seed; every replicate of every arm ran seed 42 (replicates differ only through nondeterminism).
TRAINER_SEED=42

# ---- app-balanced batch sampling (one slot per app per batch, the rest at the pool's proportions) -------
APPWORLD_APP_BALANCED_SAMPLING=1
APPWORLD_APP_BALANCE_MODE=cover

# ---- hardware / infrastructure (1 node x 8 x 80 GB GPUs) -------------------------------------------------
NUM_NODES=1
NUM_GPUS_PER_NODE=8
STRATEGY=fsdp2
GPU_MEM_UTIL=0.6
ENFORCE_EAGER=false
LANGUAGE_MODEL_ONLY=false
# AppWorld environment servers (CPU): one exclusive world per in-flight rollout. MAX_ENV_WORKERS must be
# >= TRAIN_BATCH_SIZE * N_SAMPLES and >= EVAL_BATCH_SIZE * EVAL_N_SAMPLES or the env thread pool
# deadlocks; the launcher checks it. 240 servers assume a host with ~192 vCPUs and ~2 TB RAM; lower
# NUM_APPWORLD_SERVERS on smaller hosts (rollouts then run in waves; results are unaffected).
NUM_APPWORLD_SERVERS=240
MAX_ENV_WORKERS=320
# Restart a server process every N episodes (bounds its host-memory growth). Infrastructure only: the
# episodes are identical either way (a few early arms ran without recycling).
APPWORLD_SERVER_RECYCLE_AFTER=25

# ---- checkpoints / resume / logging ---------------------------------------------------------------------
# The trainer also saves at every epoch end (every 5 steps at 90 tasks / batch 18), so a 150-step arm writes
# 30 checkpoints whatever CKPT_INTERVAL is (>= 5).
CKPT_INTERVAL=10
# -1 keeps every checkpoint (as the runs did; FINAL_TEST picks the best one of the validation curve among
# those kept). Lower it to save disk.
MAX_CKPTS_TO_KEEP=-1
# Size of one checkpoint in GB (1024^3 bytes, the preflight's unit); 4B student: 15 model + 30 optimizer
# state. Infrastructure only: run.sh sets the preflight's free-space floor under RUN_ROOT to
# min(saves, MAX_CKPTS_TO_KEEP + 1) checkpoints + 50 GB -- ~1.4 TB for a 4B arm that keeps all 30 -- unless
# OPSD_PREFLIGHT_MIN_FREE_GB is given.
CKPT_SIZE_GB=45
RESUME_MODE=latest
RESUME_PATH=
OPSD_ROLLOUT_DUMP_DIR=${RUN_DIR}/train_rollouts
