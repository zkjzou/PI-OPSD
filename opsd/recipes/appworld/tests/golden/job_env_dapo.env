# Sanitized environment of the original job behind golden "dapo" (the variables its launcher passed).
# Removed: run/project names and the cluster name. OPSD_HINTS_SOURCE = the hint file's original
# object-store key below the AppWorld prefix; test_recipe_parity.py maps it to the bundle path.
MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
MODEL_NAME=Qwen3-4B-Instruct-2507
LANGUAGE_MODEL_ONLY=false
DATA_RECIPE=traindev_evalnc
SCAFFOLD=official
PROMPT_VARIANT=official
STRICT_PARSE=true
REWARD_MODE=binary
MAX_MODEL_LEN=49152
MAX_GENERATE_LENGTH=8192
MAX_TURNS=30
N_SAMPLES=8
TRAIN_BATCH_SIZE=18
LR=3.0e-6
NUM_APPWORLD_SERVERS=240
MAX_ENV_WORKERS=320
APPWORLD_SERVER_RECYCLE_AFTER=25
VAL_ON_TEST=1
EVAL_INTERVAL=25
EVAL_N_SAMPLES=4
EVAL_BEFORE_TRAIN=false
EVAL_OOD=false
FINAL_TEST=false
CKPT_INTERVAL=10
MAX_CKPTS_TO_KEEP=-1
RESTORE_CKPT_FROM_S3=auto
TEMPERATURE=1.0
TOP_P=1.0
TOP_K=-1
MIN_P=0.0
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.8
EVAL_TOP_K=20
EVAL_MIN_P=0.0
APPWORLD_DUMP_ROLLOUTS=1
APPWORLD_WANDB_TRAJ_N=4
APPWORLD_APP_BALANCED_SAMPLING=1
APPWORLD_APP_BALANCE_MODE=cover
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
LOSS_REDUCTION=token_mean
