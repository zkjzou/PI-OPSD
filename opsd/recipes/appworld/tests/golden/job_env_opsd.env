MAX_GENERATE_LENGTH=8192
N_SAMPLES=8
TRAIN_BATCH_SIZE=18
MAX_TURNS=30
NUM_APPWORLD_SERVERS=240
MAX_ENV_WORKERS=320
CKPT_INTERVAL=10
MAX_CKPTS_TO_KEEP=-1
OPSD_WANDB_TRAJ_N=4
DUMP_ROLLOUTS=true
OPSD_KL_LOG_INTERVAL=5
SCAFFOLD=official
