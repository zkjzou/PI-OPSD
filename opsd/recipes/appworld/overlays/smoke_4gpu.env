# AppWorld refinement of common/overlays/smoke_4gpu.env (applied after it). The common overlay's
# APPWORLD_BASE_PORT=12000 and HTTP_ENDPOINT_PORT=18000 lie inside Ray's default worker-port range
# (10002-19999), which Ray workers may already hold once the trainer starts; keep both outside it, away from
# a full run's defaults (AppWorld servers 21000-21239, HTTP endpoint 8000) and from the offline scripts'
# vLLM ports (8500+).
APPWORLD_BASE_PORT=21300
HTTP_ENDPOINT_PORT=8100
