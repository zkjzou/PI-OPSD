# Student 4bi: Qwen3-4B-Instruct-2507 (dense, FSDP2, one node of 8 GPUs).
MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
# Evaluation sampling = the model's own generation config (temperature / top-p / top-k).
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.8
EVAL_TOP_K=20
EVAL_MIN_P=0.0
# vLLM tensor parallelism per engine (8 engines). The DAPO table overrides it with 2 (as run).
INFERENCE_ENGINE_TP_SIZE=1
