# Student 30bi: Qwen3-30B-A3B-Instruct-2507 (MoE, 128 experts top-8) on the Megatron backend.
# Needs the environment built with `uv sync --frozen --extra megatron`.
MODEL_PATH=Qwen/Qwen3-30B-A3B-Instruct-2507
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.8
EVAL_TOP_K=20
EVAL_MIN_P=0.0
STRATEGY=megatron
# Policy (and ref/teacher, mirrored) parallelism. One node: TP4 x CP2 -> DP1, EP8. The 2-node OPSD arms
# override MEGATRON_EP=16 (expert parallelism spans all 16 GPUs). CP=2 shards the sequence; CP=1 ran out
# of memory at this context. CP>1 requires sample packing (on by default).
MEGATRON_TP=4
MEGATRON_PP=1
MEGATRON_CP=2
MEGATRON_EP=8
MEGATRON_ETP=1
# Rollout router replay off (it broke generation on this colocated path; every 30B arm ran without it).
MOE_ROUTING_REPLAY=false
# Full CPU offload of the optimizer state: the fp32 Adam state of 30.5B parameters does not fit on 8 x 80 GB.
MEGATRON_OPTIMIZER_OFFLOAD=true
MEGATRON_OPTIMIZER_OFFLOAD_FRACTION=1.0
# vLLM: TP4 is the largest TP that divides num_key_value_heads=4 (no KV-head replication).
INFERENCE_ENGINE_TP_SIZE=4
GPU_MEM_UTIL=0.45
# Download the 61 GB checkpoint once before the workers start instead of every worker pulling it.
PRESTAGE_MODEL=1
# One 30B checkpoint is ~400 GB (2-node arms: half written by each node, all of it on the shared RUN_DIR),
# so retention must be finite. Peak = 4 checkpoints (the oldest is removed only after the new one is
# complete): run.sh's preflight wants ~1.65 TB free under RUN_ROOT.
MAX_CKPTS_TO_KEEP=3
CKPT_SIZE_GB=400
