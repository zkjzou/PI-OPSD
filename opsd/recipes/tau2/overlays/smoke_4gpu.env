# smoke_4gpu, tau2 refinement (applied after recipes/common/overlays/smoke_4gpu.env): a short
# end-to-end check of a 4B arm on 4 GPUs. NOT a reproduction -- no smoke number is comparable to a paper value.
# Shape (common overlay): first 8 train / 8 eval tasks, batch 4 tasks x 2 samples, 2 training steps,
# 1 eval sample. The arm's real hint file, simulator and judge are used (OPENAI_API_KEY is still needed).

# 4 colocated vLLM engines at TP 1 on the 4 GPUs (the base recipe asks for 8).
NUM_INFERENCE_ENGINES=4
INFERENCE_ENGINE_TP_SIZE=1

# In tau2 MAX_STEPS is the PER-EPISODE turn cap (tau2.max_steps / generator.max_turns), not a training-step
# count; ROLLOUT_BATCHES=2 x EPOCHS=1 (common overlay) bounds training to 2 steps. 60 = base.env, so this
# line is redundant today; it pins the paper's turn cap in case a shared overlay ever sets MAX_STEPS as a
# training-step count (2 would end every conversation after two messages).
MAX_STEPS=60

# A tau2 episode carries a ~5k-token domain policy plus every turn, so the common overlay's 16k window would
# drop most trajectories as over-long. Keep the paper lengths.
MAX_MODEL_LEN=40000
MAX_INPUT_LENGTH=31000
MAX_GENERATE_LENGTH=8000

# 8 concurrent episodes per step (4 x 2) need little simulator concurrency.
MAX_CONCURRENCY=16
