# tau2-bench (retail) -- run-file settings shared by every paper arm (the values the runs used).
# Layered by the resolver: base < students/<s>.env < objectives/<o>.env < pis.yaml < arms.yaml < overlays < CLI.
# Launcher: scripts/tau2/run.sh (which also applies the OPSD/mix forcing on top of these values).

# ---- data: manifests under opsd/tau2_bench/data/ (a bare file name resolves there)
VAL_DATA=retail_base.jsonl

# ---- schedule: ROLLOUT_BATCHES batches per epoch x EPOCHS = 200 steps of 16 tasks x 8 samples
EPOCHS=2
ROLLOUT_BATCHES=100
TRAIN_BATCH_SIZE=16
N_SAMPLES=8
MICRO_BATCH=1
UPDATE_EPOCHS=1
LEARNING_RATE=1e-6
SEED=42

# ---- evaluation: retail_base (114 tasks) x 4 samples, every 25 steps and before training
EVAL_N_SAMPLES=4
EVAL_BATCH_SIZE=114
EVAL_BEFORE_TRAIN=true
EVAL_INTERVAL=25
# checkpoint cadence and retention do not affect results; -1 keeps every checkpoint (~48 GB each for a 4B
# FSDP checkpoint), as the runs did. MAX_CKPTS_TO_KEEP=2 is enough to resume.
CKPT_INTERVAL=25
MAX_CKPTS_TO_KEEP=-1

# ---- lengths. MAX_STEPS is the PER-EPISODE turn cap (tau2.max_steps and generator.max_turns), not a
# training-step count. Episodes longer than MAX_RESPONSE_TOKENS are dropped from the objective.
MAX_MODEL_LEN=40000
MAX_GENERATE_LENGTH=8000
MAX_INPUT_LENGTH=31000
MAX_PROMPT_LENGTH=6144
MAX_RESPONSE_TOKENS=33000
MAX_STEPS=60

# ---- loss (DAPO-style token-mean GRPO; the vanilla-OPSD objective is forced by the launcher)
LOSS_REDUCTION=token_mean
GRPO_NORM_BY_STD=true
EPS_CLIP_LOW=0.2
EPS_CLIP_HIGH=0.28
USE_ENTROPY_LOSS=false
ENTROPY_LOSS_COEF=0.01
ZERO_VARIANCE_FILTER=true
OVERLONG_PENALTY_FACTOR=1.0
OVERLONG_REWARD_RANGE=1.0

# ---- training-time policy sampling: fully on-policy (exact importance ratios)
TRAIN_TEMPERATURE=1.0
TOP_P=1.0
TOP_K=-1
MIN_P=0.0

# ---- placement: 1 node x 8 GPUs, colocated policy + reference + 8 vLLM engines at TP 1
NUM_NODES=1
NUM_GPUS_PER_NODE=8
NUM_INFERENCE_ENGINES=8
INFERENCE_ENGINE_TP_SIZE=1
GPU_MEMORY_UTILIZATION=0.7
ENFORCE_EAGER=true
USE_SAMPLE_PACKING=true
LOGPROBS_CHUNK_SIZE=1024
CPU_OFFLOAD=false
STRATEGY=fsdp
MAX_CONCURRENCY=64

# ---- simulated user (the environment) and evaluation simulator: gpt-5.6-luna, greedy, no reasoning
# budget. Endpoint: $OPENAI_BASE_URL (default https://api.openai.com/v1), key: $OPENAI_API_KEY.
# The NL-assertion judge (40 of the 114 retail_base tasks) is openai/gpt-4.1 on the same endpoint.
SIMULATOR_MODEL=gpt-5.6-luna
SIM_TEMPERATURE=0.0
SIM_REASONING_EFFORT=none
EVAL_SIMULATOR_MODEL=gpt-5.6-luna
EVAL_SIM_TEMPERATURE=0.0

# ---- logging only (no effect on training)
SKYRL_EVAL_COMPACT=1
TAU2_DUMP_FULL_N=512
TAU2_WANDB_TRAJ_N=8
