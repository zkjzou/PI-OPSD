# opsd = vanilla OPSD (pure distillation from the frozen hint-conditioned teacher; the environment reward is
# not used: OPSD_ENV_COEF=0). OPSD=1 makes the launcher FORCE: advantage_estimator=no_op,
# policy_loss_type=importance_sampling, use_kl_in_reward=true (builds the reference worker = the frozen
# teacher), use_kl_loss=false, eps_clip_high=eps_clip_low (0.2) and max_grad_norm=0.5 (OPSD_MAX_GRAD_NORM).
# USE_KL_LOSS / KL_LOSS_COEF below are the values the runs carried before that forcing (KL_LOSS_COEF is
# recorded in the config but inert once use_kl_loss is forced off).
TRAIN_DATA=retail_tri352.jsonl
OPSD=1
OPSD_TEACHER=frozen
OPSD_ENV_COEF=0
OPSD_DISTILL_COEF=1.0
OPSD_TOKEN_CLIP=0
OPSD_REQUIRE_HINT=1
OPSD_KL_CHANNEL_SPEC=tau2
OPSD_KL_LOG_INTERVAL=25
OVERLONG_BUFFER_LEN=0
USE_KL_LOSS=true
KL_LOSS_COEF=0.001
TAU2_WANDB_TRAJ_N=4
