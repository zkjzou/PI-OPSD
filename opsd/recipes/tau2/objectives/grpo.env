# grpo = the DAPO recipe (no PI): clip-higher 0.2/0.28, token-mean loss, no KL term, and DAPO's soft
# overlong punishment with its onset at MAX_RESPONSE_TOKENS - OVERLONG_BUFFER_LEN = 20,000 tokens.
# Dynamic sampling is not used. Entry module: opsd.tau2_bench.main.
TRAIN_DATA=retail_pi424.jsonl
USE_KL_LOSS=false
KL_LOSS_COEF=0.0
OVERLONG_BUFFER_LEN=13000
MAX_GRAD_NORM=1.0
