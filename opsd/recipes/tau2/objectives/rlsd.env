# rlsd = the DAPO recipe with RLSD's multiplicative rewrite of the advantage by the frozen hinted teacher:
# A_hat = A_GRPO * ((1 - lam) + lam * clip((P_T / P_S)^sign(A), 1 - eps, 1 + eps)), lam 0.5 -> 0 over the first
# 50 steps, eps 0.2 (so from step 50 on the update is plain DAPO). Same forced recipe as opsd_grpo.
TRAIN_DATA=retail_pi424.jsonl
OPSD=1
OPSD_RLSD=1
OPSD_RLSD_LAMBDA=0.5
OPSD_RLSD_LAMBDA_FINAL=0.0
OPSD_RLSD_DECAY_STEPS=50
OPSD_RLSD_CLIP=0.2
USE_KL_LOSS=true
KL_LOSS_COEF=0.0
OVERLONG_BUFFER_LEN=13000
MAX_GRAD_NORM=1.0
OPSD_TEACHER=frozen
OPSD_TOKEN_CLIP=0
OPSD_REQUIRE_HINT=1
OPSD_KL_CHANNEL_SPEC=tau2
OPSD_KL_LOG_INTERVAL=25
