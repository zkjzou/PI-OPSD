# lamsched = opsd_grpo with a lambda schedule: lambda 0.5 -> 0.99 linearly over 100 steps, then 1.0 (plain
# DAPO) for steps 101-200. Never run to a result (configuration recorded for completeness).
TRAIN_DATA=retail_pi424.jsonl
OPSD=1
OPSD_MIX_LAMBDA=0.5
OPSD_MIX_LAMBDA_FINAL=0.99
OPSD_MIX_LAMBDA_DECAY_STEPS=100
OPSD_MIX_LAMBDA_AFTER=1.0
USE_KL_LOSS=true
KL_LOSS_COEF=0.0
OVERLONG_BUFFER_LEN=13000
MAX_GRAD_NORM=1.0
OPSD_TEACHER=frozen
OPSD_TOKEN_CLIP=0
OPSD_REQUIRE_HINT=1
OPSD_KL_CHANNEL_SPEC=tau2
OPSD_KL_LOG_INTERVAL=25
