# opsd_grpo = the DAPO recipe mixed with OPSD: A = lambda * A_GRPO + (1 - lambda) * A_SDPO, with the frozen
# hint-conditioned teacher. lambda = OPSD_MIX_LAMBDA (set per arm). OPSD=1 makes the launcher force the mix
# recipe: grpo advantage, regular (clipped) loss, KL-in-reward off, and use_kl_loss on at coefficient 0 --
# that last flag only keeps the reference worker (the frozen teacher) alive.
TRAIN_DATA=retail_pi424.jsonl
OPSD=1
USE_KL_LOSS=true
KL_LOSS_COEF=0.0
OVERLONG_BUFFER_LEN=13000
MAX_GRAD_NORM=1.0
OPSD_TEACHER=frozen
OPSD_TOKEN_CLIP=0
OPSD_REQUIRE_HINT=1
OPSD_KL_CHANNEL_SPEC=tau2
OPSD_KL_LOG_INTERVAL=25
