# 4bt = Qwen3-4B-Thinking-2507. POLICY_ENABLE_THINKING=true makes the launcher serve it with the qwen3
# reasoning parser and the thinking-preserving chat template, so the trained token stream contains the
# <think> blocks the model actually generated (the simulated user only ever sees the reply content).
# Evaluation sampling = the model card's recommended settings.
MODEL_PATH=Qwen/Qwen3-4B-Thinking-2507
POLICY_ENABLE_THINKING=true
EVAL_TEMPERATURE=0.6
EVAL_TOP_P=0.95
EVAL_TOP_K=20
EVAL_MIN_P=0.0
