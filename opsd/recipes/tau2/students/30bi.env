# 30bi = Qwen3-30B-A3B-Instruct-2507 (MoE), non-thinking. 2 nodes x 8 GPUs, Megatron backend (the FSDP
# colocate path produces garbage tokens for this MoE). Start a 2-node Ray cluster first
# (scripts/common/ray_cluster.sh) and launch on the head with RAY_ADDRESS=<head>:<port>.
# Export OPENAI_API_KEY on the head BEFORE `ray_cluster.sh head`: the simulator and judge calls run in a Ray
# task there, which sees only the environment `ray start` captured (run.sh checks this before starting).
MODEL_PATH=Qwen/Qwen3-30B-A3B-Instruct-2507
POLICY_ENABLE_THINKING=false
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.8
EVAL_TOP_K=20
EVAL_MIN_P=0.0
NUM_NODES=2
STRATEGY=megatron
MEGATRON_TP=8
MEGATRON_PP=1
MEGATRON_CP=2
MEGATRON_EP=8
MEGATRON_ETP=1
# Router replay stays OFF: the hinted teacher batch carries no rollout expert indices, so replay would
# route the teacher differently from the rollout.
MOE_ROUTING_REPLAY=false
MEGATRON_OPTIMIZER_OFFLOAD=true
# 4 engines x TP 4 = the 16 GPUs of the two nodes (colocated with the trainer).
NUM_INFERENCE_ENGINES=4
INFERENCE_ENGINE_TP_SIZE=4
GPU_MEMORY_UTILIZATION=0.45
