# ALFWorld bench defaults: every knob the launcher (scripts/alfworld/run.sh) reads, at the value every
# paper arm ran with. Values that differ by student, objective or protocol live in students/, objectives/
# and the arms.yaml tables, which are applied on top of this file (base < student < objective < pi < table).
#
# Where a value here differs from the old run-file default, the run-file default never reached a paper arm:
# every launch wrapper overrode it (e.g. EPS_CLIP_HIGH 0.28 -> 0.2, LOSS_REDUCTION -> token_mean,
# OPSD_TOKEN_CLIP 0.5 -> 0, KL_LOSS_COEF 0.05 -> 0.0). The golden-parity test
# (recipes/alfworld/tests/test_recipe_parity.py) checks this file against the launch configs.

# ---- inputs (paths under the unpacked data bundle; see opsd/data/fetch.py) ----
TASK_IDS_PATH=${OPSD_DATA_ROOT}/alfworld/splits/task_ids_train1600.json
DEV_TASK_IDS_PATH=${OPSD_DATA_ROOT}/alfworld/splits/task_ids_dev200.json

# ---- ReAct prompt contract (react prompt, THOUGHTS: label, no admissible list) ----
PROMPT_STYLE=react
SHOW_ADMISSIBLE=false
INVALID_ACTION_FEEDBACK=true
INVALID_ACTION_SHOW_ADMISSIBLE=false
# Whether the invalid-action feedback repeats the full action guide. false for every arm except the six
# 4bt trajectory-PI main arms, which ran with the guide (see arms.yaml).
INVALID_ACTION_FEEDBACK_GUIDE=false
HISTORY_LENGTH=0
ALFWORLD_REASONING_TAG=think
ALFWORLD_REASONING_PREFIX=THOUGHTS:
ALFWORLD_ONESHOT_EXAMPLE=false
ALFWORLD_FORMAT_REWARD_COEF=0.0
ALFWORLD_FORMAT_REWARD_MIN_CHARS=30
ALFWORLD_PASSCODE=false
ALFWORLD_PASSCODE_SALT=alfworld-passcode-v1
ALFWORLD_HINT_PLACEMENT=user
# Strict parsing is paired with no stop strings: with a stop on the first </action> a thinking model is cut
# inside a still-open reasoning block.
STOP_TOKENS=[]

# ---- rollout budget ----
MAX_TURNS=30
ALFWORLD_MAX_STEPS=30
MAX_PROMPT_LENGTH=2048
APPLY_OVERLONG_FILTERING=true

# ---- sampling (train is penalty-free; eval adds a presence penalty) ----
TRAIN_TEMPERATURE=1.0
TOP_P=1.0
MIN_P=0.0
EVAL_TOP_K=20
EVAL_MIN_P=0.0
EVAL_PRESENCE_PENALTY=1.5
EVAL_REPETITION_PENALTY=1.0

# ---- batch / optimisation ----
N_SAMPLES=8
TRAIN_BATCH_SIZE=16
MICRO_BATCH=1
LR=1.0e-6
MAX_GRAD_NORM=0.5
LOSS_REDUCTION=token_mean
GRPO_NORM_BY_STD=false
EPS_CLIP_LOW=0.2
EPS_CLIP_HIGH=0.2
KL_LOSS_COEF=0.0
CPU_OFFLOAD=false
USE_SAMPLE_PACKING=false
LANGUAGE_MODEL_ONLY=false
TRAINER_SEED=42

# ---- OPSD trainer knobs at their off / reference values (objectives/*.env and the tables turn them on) ----
OPSD_DISTILL_COEF=1.0
OPSD_TOKEN_CLIP=0
OPSD_LENGTH_NORM=0
OPSD_ENV_COEF=0
OPSD_TEACHER=frozen
OPSD_TEACHER_ALPHA=0.01
OPSD_EMA_INTERVAL=1
OPSD_DISTILL_LOSS_COEF=0
OPSD_MIX_LAMBDA=1.0
OPSD_RLSD=0
OPSD_RLSD_LAMBDA=0.5
OPSD_RLSD_LAMBDA_FINAL=0.0
OPSD_RLSD_DECAY_STEPS=50
OPSD_RLSD_CLIP=0.2
OPSD_SDAR_LAMBDA=0
OPSD_SDAR_BETA=5.0
OPSD_SDAR_GATE=gap
OPSD_TOKEN_ADV=0
OPSD_TOKEN_ADV_COEF=1.0
OPSD_TOKEN_ADV_STD=0
OPSD_TOKEN_ADV_ENV=broadcast
OPSD_NO_STATIC_FALLBACK=0
OPSD_SKIP_NO_HINT=0
OPSD_KL_LOG_INTERVAL=25
OPSD_WANDB_TRAJ_N=4
OPSD_DUMP_FULL_N=8
OPSD_ROLLOUT_DUMP_DIR=${RUN_DIR}/train_rollouts
SKYRL_EVAL_COMPACT=1

# ---- default protocol: train 1 epoch of the 1600-task pool (16 tasks x 8 samples = 100 steps), evaluate
# valid_seen (140) + valid_unseen (134) at N=4 every 25 steps including step 0, checkpoint every 25 and keep
# all, resume from the run's own latest checkpoint. The arms.yaml protocol anchors override per table. ----
EVAL_ONLY=false
EVAL_BEFORE_TRAIN=true
EVAL_OOD=true
EVAL_DEV=false
EVAL_POOLS_ALL=false
EVAL_N_SAMPLES=4
EVAL_BATCH_SIZE=200
EVAL_INTERVAL=25
TRAINER_EPOCHS=1
CKPT_INTERVAL=25
MAX_CKPTS_TO_KEEP=-1
ALFWORLD_REWARD_SCALE=1.0
FINAL_TEST=false
FINAL_TEST_N_SAMPLES=4
RESUME_MODE=latest
RESUME_PATH=null
RESUME_RESET_DATALOADER=0
DUMP_ROLLOUTS=true

# ---- hardware / serving (one node of 8 x 80 GB; the 30B student overrides) ----
NUM_NODES=1
NUM_GPUS_PER_NODE=8
NUM_ALFWORLD_SERVERS=128
MAX_ENV_WORKERS=256
ENFORCE_EAGER=false

# ---- Megatron layout (read only when STRATEGY=megatron, i.e. the 30B student) ----
MEGATRON_TP=4
MEGATRON_PP=1
MEGATRON_CP=1
MEGATRON_EP=8
MEGATRON_ETP=1
MEGATRON_OPTIMIZER_OFFLOAD=true
MEGATRON_OPTIMIZER_OFFLOAD_FRACTION=1.0
MOE_ROUTING_REPLAY=false

# ---- trainer selection: opsd (opsd.trainer.main_opsd_alfworld, every paper arm) or dapo
# (opsd.alfworld.main_alfworld_dapo, GRPO/DAPO with the soft overlong buffer). The keys
# below are read by the dapo entry only; no paper arm uses it. ----
ENTRY=opsd
ALFWORLD_ENABLE_THINKING=false
USE_ENTROPY_LOSS=false
ENTROPY_LOSS_COEF=0.01
LOGPROBS_CHUNK_SIZE=1024
TIS_RATIO_TYPE=null
TOKEN_TIS_RATIO_CLIP_HIGH=2.0
ZERO_REWARD_ON_NON_STOP=false
OVERLONG_BUFFER_LEN=0
OVERLONG_PENALTY_FACTOR=1.0
OVERLONG_REWARD_RANGE=10.0
