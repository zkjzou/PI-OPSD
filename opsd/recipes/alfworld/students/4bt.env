# Qwen3-4B-Thinking-2507 ("4bt"). The chat template opens the <think> block itself, so the prompt does not
# name the tags (reasoning_style=tag, think tags not in prompt). Strict parsing: the committed action must be
# a non-empty <action> after a closed </think> (paired with STOP_TOKENS=[] in base.env).
# Eval sampling is the checkpoint's official profile (T 0.6 / top-p 0.95 / top-k 20).
MODEL_PATH=Qwen/Qwen3-4B-Thinking-2507
MODEL_NAME=Qwen3-4B-Thinking-2507
ENABLE_THINKING=true
ALFWORLD_ENABLE_THINKING=true
ALFWORLD_REASONING_STYLE=tag
ALFWORLD_THINK_TAGS_IN_PROMPT=false
STRICT_ACTION_OUTSIDE_THINK=true
MAX_INPUT_LENGTH=24000
MAX_GENERATE_LENGTH=8000
MAX_MODEL_LEN=32768
TOP_K=20
EVAL_TEMPERATURE=0.6
EVAL_TOP_P=0.95
STRATEGY=fsdp2
INFERENCE_ENGINE_TP_SIZE=1
GPU_MEM_UTIL=0.7
PRESTAGE_MODEL=0
