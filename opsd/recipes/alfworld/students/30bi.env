# Qwen3-30B-A3B-Instruct-2507 ("30bi"), a MoE: Megatron backend (TP4 / PP1 / CP1 / EP8 / ETP1, CPU optimizer
# offload; layout in base.env), vLLM TP4, two nodes of 8 x 80 GB (start the cluster with
# scripts/common/ray_cluster.sh, then run the launcher on the head with RAY_ADDRESS set).
# Same prompt contract as 4bi. 16k context (12288 input + 4096 per turn). Train sampling is untruncated
# (top-k -1); eval keeps the checkpoint's official profile (T 0.7 / top-p 0.8 / top-k 20).
# PRESTAGE_MODEL=1: the launcher downloads the weights (~61 GB) into the HF cache of the node it runs on
# (the head), after preflight. The worker node needs its own copy, downloaded before it joins the cluster
# (`hf download Qwen/Qwen3-30B-A3B-Instruct-2507`, see scripts/alfworld/run.sh), unless both nodes
# share one HF_HOME; otherwise its ranks pull the weights live at model load.
MODEL_PATH=Qwen/Qwen3-30B-A3B-Instruct-2507
MODEL_NAME=Qwen3-30B-A3B-Instruct-2507
ENABLE_THINKING=false
ALFWORLD_ENABLE_THINKING=false
ALFWORLD_REASONING_STYLE=prefix
ALFWORLD_THINK_TAGS_IN_PROMPT=true
STRICT_ACTION_OUTSIDE_THINK=false
MAX_INPUT_LENGTH=12288
MAX_GENERATE_LENGTH=4096
MAX_MODEL_LEN=16384
TOP_K=-1
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.8
STRATEGY=megatron
NUM_NODES=2
INFERENCE_ENGINE_TP_SIZE=4
GPU_MEM_UTIL=0.45
PRESTAGE_MODEL=1
