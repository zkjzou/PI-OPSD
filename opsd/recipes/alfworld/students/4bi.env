# Qwen3-4B-Instruct-2507 ("4bi"). The Instruct model does not emit a reasoning tag reliably, so its reasoning
# is a plain "THOUGHTS:" label line named in the init prompt (reasoning_style=prefix, think tags in prompt).
# Eval sampling is the checkpoint's official profile (T 0.7 / top-p 0.8 / top-k 20).
MODEL_PATH=Qwen/Qwen3-4B-Instruct-2507
MODEL_NAME=Qwen3-4B-Instruct-2507
ENABLE_THINKING=false
ALFWORLD_ENABLE_THINKING=false
ALFWORLD_REASONING_STYLE=prefix
ALFWORLD_THINK_TAGS_IN_PROMPT=true
STRICT_ACTION_OUTSIDE_THINK=false
MAX_INPUT_LENGTH=32000
MAX_GENERATE_LENGTH=8000
MAX_MODEL_LEN=40960
TOP_K=20
EVAL_TEMPERATURE=0.7
EVAL_TOP_P=0.8
STRATEGY=fsdp2
INFERENCE_ENGINE_TP_SIZE=1
GPU_MEM_UTIL=0.7
PRESTAGE_MODEL=0
