# Vanilla OPSD: the reward is the teacher term alone, reward = -distill_coef * k1(student || hinted teacher)
# (OPSD_ENV_COEF=0), used as-is (no_op advantage) with an importance-sampling policy loss. The teacher is the
# FROZEN initial policy conditioned on the PI hint; use_kl_in_reward=true is what builds it.
ADVANTAGE_ESTIMATOR=no_op
POLICY_LOSS_TYPE=importance_sampling
USE_KL_IN_REWARD=true
USE_KL_LOSS=false
OPSD_ENV_COEF=0
OPSD_TEACHER=frozen
OPSD_TEACHER_ALPHA=0.01
OPSD_EMA_INTERVAL=1
OPSD_MIX_LAMBDA=1.0
OPSD_RLSD=0
OPSD_DISTILL_LOSS_COEF=0
