# OPSD+GRPO advantage mix: A = lambda * A_GRPO + (1 - lambda) * A_SDPO (lambda = OPSD_MIX_LAMBDA, set by the
# arm). The GRPO advantage comes from the PURE environment reward, so the teacher term is kept out of the
# reward (use_kl_in_reward=false; the launcher forces this whenever lambda < 1). use_kl_loss=true at
# KL_LOSS_COEF=0 adds no leash; it only keeps the reference worker (the frozen hinted teacher) alive.
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
USE_KL_IN_REWARD=false
USE_KL_LOSS=true
OPSD_ENV_COEF=0
OPSD_TEACHER=frozen
OPSD_TEACHER_ALPHA=0.01
OPSD_EMA_INTERVAL=1
OPSD_RLSD=0
OPSD_DISTILL_LOSS_COEF=0
