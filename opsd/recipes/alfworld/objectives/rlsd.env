# RLSD (arXiv:2604.03128): A_hat_t = A_GRPO * ((1 - lam) + lam * clip(w_t, 1 - eps, 1 + eps)) with
# w_t = (P_teacher / P_student)^sign(A); lam decays 0.5 -> 0 over OPSD_RLSD_DECAY_STEPS (50 unless the arm
# sets decay=<d>), eps = 0.2. The teacher is hard-copied from the student every 10 steps (ema, alpha 1.0,
# interval 10), the paper's default. A_GRPO comes from the pure environment reward (use_kl_in_reward=false).
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
USE_KL_IN_REWARD=false
USE_KL_LOSS=true
OPSD_ENV_COEF=0
OPSD_RLSD=1
OPSD_RLSD_LAMBDA=0.5
OPSD_RLSD_LAMBDA_FINAL=0.0
OPSD_RLSD_DECAY_STEPS=50
OPSD_TEACHER=ema
OPSD_TEACHER_ALPHA=1.0
OPSD_EMA_INTERVAL=10
OPSD_MIX_LAMBDA=1.0
OPSD_DISTILL_LOSS_COEF=0
