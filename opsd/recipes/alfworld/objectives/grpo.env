# Matched no-PI GRPO control: the RLSD pipeline (objectives/rlsd.env) with lam pinned to 0, so
# A_hat = A_GRPO exactly. The hint file is still loaded and the teacher forward still runs (same compute and
# code path as the PI arms), but the teacher never reaches the gradient.
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
USE_KL_IN_REWARD=false
USE_KL_LOSS=true
OPSD_ENV_COEF=0
OPSD_RLSD=1
OPSD_RLSD_LAMBDA=0
OPSD_RLSD_LAMBDA_FINAL=0
OPSD_RLSD_DECAY_STEPS=0
OPSD_TEACHER=ema
OPSD_TEACHER_ALPHA=1.0
OPSD_EMA_INTERVAL=10
OPSD_MIX_LAMBDA=1.0
OPSD_DISTILL_LOSS_COEF=0
