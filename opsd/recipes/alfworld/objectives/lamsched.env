# Scheduled advantage mix: lambda rises linearly 0.5 -> 0.99 over the first 100 steps, then jumps to 1.0
# (pure GRPO) for the rest of the run. Otherwise identical to objectives/opsd_grpo.env. The teacher-ablation
# table varies only the teacher on top of this schedule.
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
USE_KL_IN_REWARD=false
USE_KL_LOSS=true
OPSD_ENV_COEF=0
OPSD_TEACHER=frozen
OPSD_TEACHER_ALPHA=0.01
OPSD_EMA_INTERVAL=1
OPSD_RLSD=0
OPSD_DISTILL_LOSS_COEF=0
OPSD_MIX_LAMBDA=0.5
OPSD_MIX_LAMBDA_FINAL=0.99
OPSD_MIX_LAMBDA_DECAY_STEPS=100
OPSD_MIX_LAMBDA_AFTER=1.0
