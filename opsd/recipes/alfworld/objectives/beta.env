# Env-anchored OPSD (the earlier coefficient sweep): GRPO on the environment reward (OPSD_ENV_COEF=1.0, reward
# scale 1.0) with the teacher entering through ONE extra channel chosen by the arm:
#   beta=<b>          OPSD_DISTILL_LOSS_COEF: teacher KL as its own loss term in the policy worker;
#   lambda=<l>        OPSD_MIX_LAMBDA: the advantage mix of objectives/opsd_grpo.env;
#   decay=<d> + OPSD_RLSD=1 (table env): the multiplicative RLSD reweighting of objectives/rlsd.env.
ADVANTAGE_ESTIMATOR=grpo
POLICY_LOSS_TYPE=regular
USE_KL_IN_REWARD=false
USE_KL_LOSS=true
OPSD_ENV_COEF=1.0
OPSD_TEACHER=frozen
OPSD_TEACHER_ALPHA=0.01
OPSD_EMA_INTERVAL=1
OPSD_MIX_LAMBDA=1.0
OPSD_RLSD=0
OPSD_DISTILL_LOSS_COEF=0
