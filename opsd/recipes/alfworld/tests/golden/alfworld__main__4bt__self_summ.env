# Launch configuration of alfworld/main/4bt/self_summ
# as recorded when the arm was submitted. Sanitized: object-store URIs are mapped to ${OPSD_DATA_ROOT}
# paths; run-name, tracking-project and host-local path keys are removed. See ../test_recipe_parity.py.
ADVANTAGE_ESTIMATOR=no_op
ALFWORLD_BASE_PORT=9100
ALFWORLD_FORMAT_REWARD_COEF=0.0
ALFWORLD_FORMAT_REWARD_MIN_CHARS=30
ALFWORLD_MAX_STEPS=30
ALFWORLD_ONESHOT_EXAMPLE=false
ALFWORLD_REASONING_PREFIX=THOUGHTS:
ALFWORLD_REASONING_STYLE=tag
ALFWORLD_REASONING_TAG=think
ALFWORLD_REWARD_SCALE=1.0
ALFWORLD_THINK_TAGS_IN_PROMPT=false
CKPT_INTERVAL=10
DEV_TASK_IDS_PATH=${OPSD_DATA_ROOT}/alfworld/splits/task_ids_dev200.json
DUMP_ROLLOUTS=true
ENABLE_THINKING=true
EPS_CLIP_HIGH=0.2
EPS_CLIP_LOW=0.2
EVAL_BATCH_SIZE=64
EVAL_BEFORE_TRAIN=true
EVAL_DEV=false
EVAL_INTERVAL=10
EVAL_MIN_P=0.0
EVAL_N_SAMPLES=4
EVAL_ONLY=false
EVAL_OOD=true
EVAL_POOLS_ALL=false
EVAL_PRESENCE_PENALTY=1.5
EVAL_REPETITION_PENALTY=1.0
EVAL_TEMPERATURE=0.6
EVAL_TOP_K=20
EVAL_TOP_P=0.95
FINAL_TEST=false
FINAL_TEST_N_SAMPLES=4
GPU_MEM_UTIL=0.7
HISTORY_LENGTH=0
INFERENCE_ENGINE_TP_SIZE=1
INVALID_ACTION_FEEDBACK=true
INVALID_ACTION_FEEDBACK_GUIDE=false
INVALID_ACTION_SHOW_ADMISSIBLE=false
KL_LOSS_COEF=0.0
LANGUAGE_MODEL_ONLY=false
LOSS_REDUCTION=token_mean
LR=1.0e-6
MAX_CKPTS_TO_KEEP=-1
MAX_ENV_WORKERS=256
MAX_GENERATE_LENGTH=8000
MAX_INPUT_LENGTH=24000
MAX_MODEL_LEN=32768
MAX_TURNS=30
MEGATRON_CP=1
MEGATRON_EP=8
MEGATRON_ETP=1
MEGATRON_OPTIMIZER_OFFLOAD=true
MEGATRON_OPTIMIZER_OFFLOAD_FRACTION=1.0
MEGATRON_PP=1
MEGATRON_TP=4
MICRO_BATCH=1
MIN_P=0.0
MODEL_NAME=Qwen3-4B-Thinking-2507
MODEL_PATH=Qwen/Qwen3-4B-Thinking-2507
MOE_ROUTING_REPLAY=false
NUM_ALFWORLD_SERVERS=128
NUM_GPUS_PER_NODE=8
N_SAMPLES=8
OPSD_DISTILL_COEF=1.0
OPSD_DISTILL_LOSS_COEF=0
OPSD_EMA_INTERVAL=1
OPSD_ENV_COEF=0
OPSD_HINTS_PATH=${OPSD_DATA_ROOT}/alfworld/hints/derived/summary/4bt_from_glm.json
OPSD_KL_LOG_INTERVAL=25
OPSD_MIX_LAMBDA=1.0
OPSD_REF_SEQ_CAP=65536
OPSD_RLSD=0
OPSD_RLSD_CLIP=0.2
OPSD_RLSD_DECAY_STEPS=50
OPSD_RLSD_LAMBDA=0.5
OPSD_RLSD_LAMBDA_FINAL=0.0
OPSD_TEACHER=frozen
OPSD_TEACHER_ALPHA=0.01
OPSD_TOKEN_ADV=0
OPSD_TOKEN_ADV_COEF=1.0
OPSD_TOKEN_ADV_ENV=broadcast
OPSD_TOKEN_ADV_STD=0
OPSD_TOKEN_CLIP=0
OPSD_WANDB_TRAJ_N=4
POLICY_LOSS_TYPE=importance_sampling
PRESTAGE_MODEL=0
PROMPT_STYLE=react
RESUME_MODE=null
RESUME_PATH=null
RESUME_RESET_DATALOADER=0
SHOW_ADMISSIBLE=false
STOP_TOKENS=[]
STRATEGY=fsdp2
STRICT_ACTION_OUTSIDE_THINK=true
TASK_IDS_PATH=${OPSD_DATA_ROOT}/alfworld/splits/task_ids_train1600.json
TOP_K=20
TOP_P=1.0
TRAINER_EPOCHS=1
TRAIN_TEMPERATURE=1.0
USE_KL_IN_REWARD=true
USE_KL_LOSS=false
